<view class="hero"><text class="small">CLEAN SPACE · 每日卫生管理</text><view class="title">让整洁，成为每天的习惯。</view><text>完成清洁，拍照留存，安心收工。</text></view><view class="container"><view class="tabs"><button bindtap="showCheck" class="{{tab===0?'active':''}}">卫生打卡</button><button bindtap="showRecords" class="{{tab===1?'active':''}}">打卡记录 · {{records.length}}</button></view><view wx:if="{{tab===0}}"><view class="panel"><view class="heading">打卡人信息</view><view class="label">员工姓名</view><input placeholder="请输入姓名" maxlength="30" value="{{name}}" bindinput="onName" disabled="{{saving}}"/><view class="label">打卡日期</view><picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate" disabled="{{saving}}"><view class="date">{{date}}</view></picker></view><view class="section"><text>清洁区域</text><text class="muted">已完成 {{completed}} / 3</text></view><view class="card" wx:for="{{areas}}" wx:key="name"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewDraft"/><view wx:else class="placeholder">◎ 清洁完成，拍照留存</view><view class="body"><view class="section"><text>{{item.name}}</text><text class="muted">{{item.path?'✓ 已上传':'待上传 · 必填'}}</text></view><button data-index="{{index}}" bindtap="choose" disabled="{{saving || choosing}}">{{item.path?'更换照片':'＋ 拍照 / 上传照片'}}</button></view></view><view class="tip">记录保存在当前设备，请勿清理小程序数据。</view><button class="primary" bindtap="submit" loading="{{saving}}" disabled="{{!ready || saving || choosing}}">提交今日打卡</button></view><view wx:else><view class="empty" wx:if="{{!records.length}}">还没有记录，完成第一次打卡吧。</view><view class="panel" wx:for="{{records}}" wx:key="id" wx:for-item="record"><view class="record-head"><view><view class="heading">{{record.name}}</view><view class="muted">{{record.date}} · {{record.time}}</view></view><button class="delete-button" data-id="{{record.id}}" bindtap="deleteRecord">删除</button></view><button wx:if="{{!record.expanded}}" class="toggle-button" data-id="{{record.id}}" bindtap="togglePhotos">查看图片</button><button wx:else class="toggle-button" data-id="{{record.id}}" bindtap="togglePhotos">收起图片</button><view wx:if="{{record.expanded}}" class="record-photo" wx:for="{{record.photos}}" wx:key="name" wx:for-item="photo"><view>{{photo.name}}</view><image src="{{photo.path}}" mode="aspectFill" data-id="{{record.id}}" data-url="{{photo.path}}" bindtap="previewRecord"/></view></view></view></view>

